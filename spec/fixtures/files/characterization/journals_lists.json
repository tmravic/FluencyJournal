  "list/all": {
    "status": 200,
    "location": null,
    "body": [
      "    <header class=\"navbar\">",
      "    <div class=\"navbar__languages\">",
      "      En → Ja",
      "    </div>",
      "    <div class=\"navbar__name\">",
      "      Jl-USER",
      "    </div>",
      "  <a data-turbo-frame=\"notes_box\" class=\"btn btn--primary navbar__notes-button\" href=\"/notes\">Note</a>",
      "    <button type=\"button\"",
      "            data-controller=\"theme\"",
      "            data-action=\"click->theme#toggle\"",
      "            data-theme-light-label-value=\"Switch to light mode\"",
      "            data-theme-dark-label-value=\"Switch to dark mode\"",
      "            class=\"btn btn--light theme-toggle\"",
      "            aria-label=\"Toggle dark mode\">",
      "      <span data-theme-target=\"icon\">🌙</span>",
      "    </button>",
      "    <form class=\"button_to\" method=\"post\" action=\"/session\"><input type=\"hidden\" name=\"_method\" value=\"delete\" autocomplete=\"off\" /><button class=\"btn btn--dark navbar__right\" type=\"submit\">Logout</button></form>",
      "</header>",
      "    <div id=\"flash\" class=\"flash\">",
      "    </div>",
      "      <turbo-cable-stream-source channel=\"Turbo::StreamsChannel\" signed-stream-name=\"SIGNED\"></turbo-cable-stream-source>",
      "<div class=\"container\">",
      "  <turbo-frame id=\"notes_box\"></turbo-frame>",
      "  <turbo-frame id=\"workspace\"></turbo-frame>",
      "  <div class=\"header\">",
      "    <turbo-frame id=\"journals_title\">",
      "      <h1>",
      "        <!--All Journals-->",
      "        All Journals",
      "      </h1>",
      "</turbo-frame>",
      "      <turbo-frame id=\"switch_button\">",
      "        <a data-turbo-stream=\"true\" class=\"btn btn--secondary btn--manage-journal\" href=\"/journals\">Today&#39;s Journals</a>",
      "</turbo-frame>",
      "    <turbo-frame id=\"close_journal_button\"></turbo-frame>",
      "    <turbo-frame id=\"start_journal_button\">",
      "      <a class=\"btn btn--primary btn--manage-journal\" data-turbo-frame=\"new_journal\" href=\"/journals/new?from_all_or_todays=all\">Start Journal</a>",
      "</turbo-frame>  </div>",
      "  <turbo-frame id=\"new_journal\">",
      "</turbo-frame>",
      "  <turbo-frame id=\"journals\">",
      "    <turbo-frame id=\"journal_J_OTHER_DUE\">",
      "  <div class=\"journal\">",
      "    <a data-turbo-frame=\"_top\" href=\"/journals/J_OTHER_DUE\">A due</a>",
      "    <div class=\"journal__actions\">",
      "        <span class=\"journal__date\">",
      "          <!--Next review: MM/DD/YYYY -->",
      "          Next review: <br><time datetime=\"2026-03-08T00:00:00Z\" data-local=\"weekday-or-date\">2026-03-08</time>",
      "        </span>",
      "      <a data-turbo=\"true\" class=\"btn btn--light\" href=\"/journals/J_OTHER_DUE/edit?from_all_or_todays=all\">Edit</a>",
      "      <form data-turbo-confirm=\"Really delete this journal?\" class=\"button_to\" method=\"post\" action=\"/journals/J_OTHER_DUE?from_all_or_todays=all\"><input type=\"hidden\" name=\"_method\" value=\"delete\" autocomplete=\"off\" /><button class=\"btn btn--light\" type=\"submit\">Delete</button></form>",
      "    </div>",
      "  </div>",
      "</turbo-frame><turbo-frame id=\"journal_J_DUE\">",
      "  <div class=\"journal\">",
      "    <a data-turbo-frame=\"_top\" href=\"/journals/J_DUE\">B due</a>",
      "    <div class=\"journal__actions\">",
      "        <span class=\"journal__date\">",
      "          <!--Next review: MM/DD/YYYY -->",
      "          Next review: <br><time datetime=\"2026-03-09T00:00:00Z\" data-local=\"weekday-or-date\">2026-03-09</time>",
      "        </span>",
      "      <a data-turbo=\"true\" class=\"btn btn--light\" href=\"/journals/J_DUE/edit?from_all_or_todays=all\">Edit</a>",
      "      <form data-turbo-confirm=\"Really delete this journal?\" class=\"button_to\" method=\"post\" action=\"/journals/J_DUE?from_all_or_todays=all\"><input type=\"hidden\" name=\"_method\" value=\"delete\" autocomplete=\"off\" /><button class=\"btn btn--light\" type=\"submit\">Delete</button></form>",
      "    </div>",
      "  </div>",
      "</turbo-frame><turbo-frame id=\"journal_J_DONE\">",
      "  <div class=\"journal\">",
      "    <a data-turbo-frame=\"_top\" href=\"/journals/J_DONE\">D done</a>",
      "    <div class=\"journal__actions\">",
      "        <span class=\"journal__date\">",
      "          <!--Next review: MM/DD/YYYY -->",
      "          Next review: <br><time datetime=\"2026-03-12T00:00:00Z\" data-local=\"weekday-or-date\">2026-03-12</time>",
      "        </span>",
      "      <a data-turbo=\"true\" class=\"btn btn--light\" href=\"/journals/J_DONE/edit?from_all_or_todays=all\">Edit</a>",
      "      <form data-turbo-confirm=\"Really delete this journal?\" class=\"button_to\" method=\"post\" action=\"/journals/J_DONE?from_all_or_todays=all\"><input type=\"hidden\" name=\"_method\" value=\"delete\" autocomplete=\"off\" /><button class=\"btn btn--light\" type=\"submit\">Delete</button></form>",
      "    </div>",
      "  </div>",
      "</turbo-frame><turbo-frame id=\"journal_J_LATER\">",
      "  <div class=\"journal\">",
      "    <a data-turbo-frame=\"_top\" href=\"/journals/J_LATER\">C later</a>",
      "    <div class=\"journal__actions\">",
      "        <span class=\"journal__date\">",
      "          <!--Next review: MM/DD/YYYY -->",
      "          Next review: <br><time datetime=\"2026-03-13T00:00:00Z\" data-local=\"weekday-or-date\">2026-03-13</time>",
      "        </span>",
      "      <a data-turbo=\"true\" class=\"btn btn--light\" href=\"/journals/J_LATER/edit?from_all_or_todays=all\">Edit</a>",
      "      <form data-turbo-confirm=\"Really delete this journal?\" class=\"button_to\" method=\"post\" action=\"/journals/J_LATER?from_all_or_todays=all\"><input type=\"hidden\" name=\"_method\" value=\"delete\" autocomplete=\"off\" /><button class=\"btn btn--light\" type=\"submit\">Delete</button></form>",
      "    </div>",
      "  </div>",
      "</turbo-frame>",
      "</turbo-frame></div>",
      "  </body>",
      "</html>"
    ]
  },
