<main class="container container--homepage stack">
  <h1><%= t("app_name") %></h1>
  <p><%= t("tagline") %></p>
  <% if Current.user.present? %>
    <%= link_to t("journal.view_journals"), journals_path, class: "btn btn--dark btn--homepage" %>
  <% else %>
    <%= link_to t("sign_in"), new_session_path, class: "btn btn--dark btn--homepage" %>
  <% end %>

  <%= turbo_frame_tag "notes_box" %>
</main>
