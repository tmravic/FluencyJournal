<%= turbo_frame_tag "change_journal_due_date_button" do %>
  <div>
    <%= form_with url: update_due_date_journal_path(@journal),
                  method: :post do |f| %>
      <%= f.date_field :next_study_date, value: @journal.next_study_date&.to_date %>
      <%= f.submit "Save", class: "btn btn--light" %>
    <% end %>
  </div>
<% end %>
