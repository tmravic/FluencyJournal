<!-- rendered by app/views/journals/show.html.erb in this line: -->
<!-- render "journals/journal_content", journal: @journal, entries: @entries -->

<%= turbo_frame_tag "workspace" do %>
  <div class="header">
    <h2><%= @journal.title %></h2>

    <%= turbo_frame_tag "open_ai_assistant_button" do %>
      <%= render "entries/open_ai_assistant_button" %>
    <% end %>
    <%= turbo_frame_tag "close_ai_assistant_button" %>

    <%= turbo_frame_tag "start_entry_button" do %>
      <%= render 'entries/start_entry_button' %>
    <% end %>

    <%= turbo_frame_tag "compare_button" do %>
      <%= render 'journals/compare_button' %>
    <% end %>

    <%= turbo_frame_tag "double_check_button" do %>
      <!-- changed this to just say "Followup" -->
      <%= render 'journals/double_check_button', journal: @journal if @entries.present? %>
    <% end %>

    <%= turbo_frame_tag "linked_notes_button" do %>
      <%= render "journals/linked_notes_button", journal: @journal %>
    <% end %>

    <%= turbo_frame_tag "reading_mode_button" do %>
      <%= render 'journals/reading_mode_button', locals: { journal: @journal } if @entries.present? %>
    <% end %>

    <%= turbo_frame_tag "quiz_buttons" do %>
      <%= render 'quizzes/quiz_buttons' if @entries.present? %>
    <% end %>

    <%= turbo_frame_tag "mark_studied_button" do %>
      <% if @entries.present? %>
        <%= render partial: 'journals/mark_studied_button', locals: { journal: @journal } %>
      <% end %>
    <% end %>

    <%= turbo_frame_tag "change_journal_due_date_button" do %>
      <%= render 'journals/change_journal_due_date_button', locals: { journal: @journal } if @entries.present? %>
    <% end %>
  </div>
  <br>

  <%= turbo_frame_tag "compare" %>

  <div style="display:flex;justify-content:space-between;align-items:center;">

    <span class="journal__date">
      <%= t("journal.first_written") %>: <%= @journal.created_at.strftime("%m/%d/%Y") %>
    </span>

    <span class="journal__date">
      <%= turbo_frame_tag "character_count" do %>
        <%= render partial: 'journals/character_count', locals: { journal: @journal } %>
      <% end %>
    </span>

    <span class="journal__date">
      <%= turbo_frame_tag "next_review_timestamp" do %>
        <%= render partial: 'journals/next_review_timestamp', locals: { journal: @journal } %>
      <% end %>
    </span>

  </div>
  <%= render 'entries/entries_frame' %>

  <%= turbo_frame_tag Entry.new do %>
    <%= render 'entries/empty_state' unless @entries.present? %>
  <% end %>
  <hr style="margin: 10px 0;">
  <%= turbo_frame_tag "previous_queries" do %>
    <% if @journal.ai_queries.any? %>
      <%= render partial: "journals/previous_queries", locals: { journal: @journal } %>
    <% end %>
  <% end %>
  <hr style="margin: 10px 0;">
  <%= turbo_frame_tag "ai_assistant" %>
  <%= turbo_frame_tag "followup_output_ai_assistant" %>
  <br>
<% end %>
