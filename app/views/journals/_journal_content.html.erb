<div class="header">
  <h3><%= @journal.title %></h3>

  <%= turbo_frame_tag "open_ai_assistant_button" do %>
    <%= render "entries/open_ai_assistant_button" %>
  <% end %>
  <%= turbo_frame_tag "close_ai_assistant_button" %>

  <%= turbo_frame_tag "start_entry_button" do %>
    <%= render 'entries/start_entry_button' %>
  <% end %>
</div>

<%= turbo_frame_tag "entries" do %>
  <% if @entries.present? %>
    <%= render 'entries/empty_state' %>
    <%= render @entries, journal: @journal, source_tag: @source_tag %>
  <% end %>
<% end %>

<%= turbo_frame_tag Entry.new do %>
  <%= render 'entries/empty_state' unless @entries.present? %>
<% end %>
<hr style="margin: 10px 0;">
<%= turbo_frame_tag "previous_queries" do %>
  <% if @journal.ai_queries.any? %>
    <%= render partial: "journals/previous_queries", locals: { journal: @journal } %>
  <% end %>
<% end %>

<%= turbo_frame_tag "ai_assistant" %>
<br>
