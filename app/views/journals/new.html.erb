<% content_for :title, "New journal" %>
<main class="container">
  <%= link_to sanitize("&larr; #{t('journal.back_to_journals')}"), journals_path %>

  <div class="header">
    <h1>New journal</h1>
  </div>

  <%= turbo_frame_tag @journal do %>
    <%= render "form", journal: @journal, from_all_or_todays: @from_all_or_todays %>
  <% end %>
</main>
