<%= turbo_stream.update Journal.new, "" %>
<%= turbo_stream.replace "workspace", partial: "journals/journal_content", locals: { journal: @journal } %>
<% if @from_all_or_todays == "todays" %>
  <%= turbo_stream.update "close_journal_button", partial: "journals/close_journal_button" %>
<% else %>
  <%= turbo_stream.update "close_journal_button", partial: "journals/close_journal_button_all" %>
<% end %>
<%= turbo_stream.update "open_ai_assistant_button" do %>
  <%= render OpenAiAssistantButtonComponent.new(journal: @journal) %>
<% end %>
<%= turbo_stream.update "start_journal_button", "" %>
<%= render_turbo_stream_flash_messages %>
