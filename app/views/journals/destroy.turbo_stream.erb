<%= turbo_stream.remove @journal %>
<%= turbo_stream.update "workspace", "" %>
<%= turbo_stream.update "close_ai_assistant_button", "" %>
<% if @journals.empty? %>
  <%= turbo_stream.update dom_id(Journal.new) do %>
    <%= render 'journals/empty_state' %>
  <% end %>
<% end %>
<%= render_turbo_stream_flash_messages %>
