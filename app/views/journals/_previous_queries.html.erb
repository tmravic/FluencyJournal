<!---------------------------------------->
<!--Previous AI Questions and Followups-->
<!--Q Q F Q F F-->
<!---------------------------------------->
<%# A rewrite shows its own questions. The R chips stay on the parent. %>
<% rewrites_journal = journal.rewrite? ? journal.source_journal : journal %>

<% if journal.ai_queries.any? %>
<h4><%= t("followup.previous") %></h4>
<% journal.ai_queries.each do |query| %>
  <% followup = query.prompt&.followup %>
  <% if followup %>
    <%= link_to t("followup.short"),
                followup_path(followup, source_tag: SourceTag::AI_ASSISTANT),
                class: "btn btn--primary",
                data: {
                  turbo_frame: followup_turbo_frame(SourceTag::AI_ASSISTANT),
                  controller: "scroll",
                  action: "click->scroll#scrollToTarget",
                  scroll_target_value: followup_turbo_frame(SourceTag::AI_ASSISTANT)
                } %>
  <% elsif query.prompt&.listable? %>
    <%= link_to t("ai_query.short"),
                journal_ai_query_path(journal, query),
                class: "btn btn--secondary",
                data: {
                  turbo_frame: "ai_assistant",
                  controller: "scroll",
                  action: "click->scroll#scrollToTarget",
                  scroll_target_value: "ai_assistant"
                } %>
  <% end %>
<% end %>
<% end %>

<% if rewrites_journal.rewrites.any? %>
  <h4><%= t("journal.rewrites") %></h4>
  <% rewrites_journal.rewrites.each do |rewrite| %>
    <%= link_to t("journal.rewrite_short"),
                journal_rewrite_path(rewrites_journal, rewrite),
                class: "btn btn--light",
                data: { turbo_stream: true } %>
  <% end %>
<% end %>
