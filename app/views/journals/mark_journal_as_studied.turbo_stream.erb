<% unless @from_all_or_todays == "all" %>
  <%= turbo_stream.remove @journal %>
<% end %>
<% if @show_todays_journals_empty_state %>
  <%= turbo_stream.update dom_id(Journal.new),
                          partial: "journals/empty_state_today",
                          locals: { from_all_or_todays: @from_all_or_todays.presence || "todays" } %>
<% end %>
<%= turbo_stream.update "next_review_timestamp",
                        partial: "journals/next_review_timestamp",
                        locals: { journal: @journal } %>
<%= turbo_stream.update "mark_studied_button", "" %>
<%= turbo_stream.update "due_today_journals_count",
                        partial: "journals/todays_journal_count" %>
<%= render_turbo_stream_flash_messages %>
