<%= turbo_frame_tag journal do %>
  <div class="journal">
    <%= link_to journal.title,
                journal_path(journal),
                data: { turbo_frame: "_top" } %>
    <span class="journal__date"><%= journal.created_at.strftime("%m/%d/%Y") %></span>
    <div class="journal__actions">
      <%= link_to "Edit",
                  edit_journal_path(journal),
                  data: { turbo: true },
                  class: "btn btn--light" %>
      <%= button_to "Delete",
                    journal_path(journal),
                    method: :delete,
                    form: { data: { turbo_confirm: "Really delete this journal?" } },
                    class: "btn btn--light" %>
    </div>
  </div>
<% end %>
