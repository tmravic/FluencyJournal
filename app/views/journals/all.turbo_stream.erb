<%= turbo_stream.update "journals_title" do %>
  <h1><%= t("journal.all_journals") %></h1>
<% end %>

<%= turbo_stream.update "switch_button" do %>
  <%= render 'journals/todays_journals_button' %>
<% end %>

<%= turbo_stream.update "journals" do %>
  <%= render partial: "journals/journal", collection: @all_journals, as: :journal, locals: { mode: :all } %>
<% end %>

<%= turbo_stream.update dom_id(Journal.new) do %>
  <%= render partial: 'journals/empty_state', locals: { from_all_or_todays: @from_all_or_todays } unless @all_journals.present? %>
<% end %>

<%= turbo_stream.update "workspace", "" %>
<%= turbo_stream.update "due_today_journals_count", "" %>
<%= turbo_stream.update "close_journal_button", "" %>
<%= turbo_stream.update "start_journal_button", partial: "journals/start_journal_button", locals: { from_all_or_todays: @from_all_or_todays } %>
<%= render_turbo_stream_flash_messages %>
