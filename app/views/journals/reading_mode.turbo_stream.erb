<% if @reading_mode %>

  <%= turbo_stream.update "entries" do %>
    <% @entries.each do |entry| %>
      <div class="entry">
        <p>
          <%= simple_format(entry.content) %>
        </p>
      </div>
    <% end %>
  <% end %>

  <%= turbo_stream.update "ai_assistant", '' %>
  <%= turbo_stream.update "open_ai_assistant_button", '' %>
  <%= turbo_stream.update "start_entry_button", '' %>
  <%= turbo_stream.update "quiz_buttons", '' %>
  <%= turbo_stream.update "mark_studied_button", '' %>
  <%= turbo_stream.update "change_journal_due_date_button", '' %>
  <%= turbo_stream.update "reading_mode_button",
                          partial: 'journals/reading_mode_button',
                          locals: { journal: @journal, reading_mode: false } %>
  <%= turbo_stream.update "previous_queries", '' %>

<% else %>

  <%= turbo_stream.update "entries" do %>
    <%= render 'entries/entries_frame' %>
  <% end %>

  <%= turbo_stream.update "open_ai_assistant_button", partial: 'entries/open_ai_assistant_button' %>
  <%= turbo_stream.update "start_entry_button", partial: 'entries/start_entry_button' %>

  <% if @journal.entries.present? %>
    <%= turbo_stream.update "quiz_buttons", partial: 'quizzes/quiz_buttons' %>
    <%= turbo_stream.update "mark_studied_button",
                            partial: 'journals/mark_studied_button',
                            locals: { journal: @journal } %>
    <%= turbo_stream.update "reading_mode_button",
                            partial: 'journals/reading_mode_button',
                            locals: { journal: @journal, reading_mode: false } %>
    <%= turbo_stream.update "change_journal_due_date_button",
                            partial: 'journals/change_journal_due_date_button',
                            locals: { journal: @journal, reading_mode: false } %>
  <% end %>

  <% if @journal.ai_queries.any? %>
    <%= turbo_stream.update "previous_queries",
                            partial: "journals/previous_queries",
                            locals: { journal: @journal } %>
  <% end %>

<% end %>
