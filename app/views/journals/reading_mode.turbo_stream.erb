<% if @reading_mode %>

  <%= turbo_stream.update "entries" do %>
    <% @entries.each do |entry| %>
      <div class="entry">
        <p>
          <%= simple_format(entry.content) %>
        </p>
      </div>
    <% end %>
  <% end %>

  <%= turbo_stream.update "ai_assistant", '' %>
  <%= turbo_stream.update "open_ai_assistant_button", '' %>
  <%= turbo_stream.update "start_entry_button", '' %>
  <%= turbo_stream.update "quiz_buttons", '' %>
  <%= turbo_stream.update "mark_studied_button", '' %>
  <%= turbo_stream.update "change_journal_due_date_button", '' %>
  <%= turbo_stream.update "double_check_button", '' %>
  <%= turbo_stream.update "linked_notes_button", '' %>
  <%= turbo_stream.update "compare_button", '' %>
  <%= turbo_stream.update "reading_mode_button" do %>
    <%= render ReadingModeButtonComponent.new(journal: @journal, reading_mode: @reading_mode) %>
  <% end %>
  <%= turbo_stream.update "previous_queries", '' %>

<% else %>

  <%= turbo_stream.update "entries" do %>
    <%= render "entries/entries_list" %>
  <% end %>

  <%= turbo_stream.update "open_ai_assistant_button" do %>
    <%= render OpenAiAssistantButtonComponent.new(journal: @journal) %>
  <% end %>
  <%= turbo_stream.update "start_entry_button" do %>
    <%= render StartEntryButtonComponent.new(journal: @journal) %>
  <% end %>

  <% if @journal.entries.present? %>
    <%= turbo_stream.update "quiz_buttons" do %>
      <%= render QuizButtonsComponent.new(journal: @journal) %>
    <% end %>
    <%= turbo_stream.update "mark_studied_button" do %>
      <%= render MarkStudiedButtonComponent.new(journal: @journal, from_all_or_todays: @from_all_or_todays) %>
    <% end %>
    <%= turbo_stream.update "reading_mode_button" do %>
      <%= render ReadingModeButtonComponent.new(journal: @journal, reading_mode: @reading_mode) %>
    <% end %>
    <%= turbo_stream.update "change_journal_due_date_button" do %>
      <%= render ChangeDueDateButtonComponent.new(journal: @journal) %>
    <% end %>
    <%= turbo_stream.update "double_check_button" do %>
      <%= render DoubleCheckButtonComponent.new(journal: @journal) %>
    <% end %>
    <%= turbo_stream.update "linked_notes_button" do %>
      <%= render LinkedNotesButtonComponent.new(journal: @journal) %>
    <% end %>
    <%= turbo_stream.update "compare_button" do %>
      <%= render CompareButtonComponent.new(journal: @journal) %>
    <% end %>
  <% end %>

  <% if @journal.ai_queries.any? %>
    <%= turbo_stream.update "previous_queries",
                            partial: "journals/previous_queries",
                            locals: { journal: @journal } %>
  <% end %>

<% end %>
