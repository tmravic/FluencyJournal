<%= simple_form_for journal, html: { class: "journal form" }, data: { turbo: true } do |f| %>
  <%= form_error_notification(journal) %>

  <%= f.input :title, input_html: { autofocus: true } %>
  <%= f.hidden_field :from_all_or_todays, value: from_all_or_todays %>

  <div class="form__input__button_block">
    <%= link_to t("cancel"), journals_path, class: "btn btn--light" %>
    <%= f.submit class: "btn btn--secondary" %>
  </div>
<% end %>
