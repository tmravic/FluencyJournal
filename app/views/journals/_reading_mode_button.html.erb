<% if @reading_mode %>
  <%= link_to t('journal.actions.reading_mode'),
              reading_mode_journal_path(@journal, reading_mode: false),
              class: "btn btn--dark",
              data: { turbo_stream: true } %>
<% else %>
  <%= link_to t('journal.actions.reading_mode'),
              reading_mode_journal_path(@journal, reading_mode: true),
              class: "btn btn--light",
              data: { turbo_stream: true } %>
<% end %>
