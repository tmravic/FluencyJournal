<% content_for :title, "#{t("app_name")} - #{t("journal.journals")}" %>
<%= turbo_stream_from current_group, "journals" %>

<div class="container">

  <%= turbo_frame_tag "notes_box", src: notes_path do %>

  <% end %>

  <%= turbo_frame_tag "workspace" %>

  <div class="header">
    <%= turbo_frame_tag "journals_title" do %>
      <h1>
        <!--Today's Journals-->
        <%= t("journal.todays_journals") %>
      </h1>
    <% end %>

      <%= turbo_frame_tag "switch_button" do %>
        <%= render 'journals/all_journals_button' %>
      <% end %>

    <%= turbo_frame_tag "close_journal_button" %>

    <%= turbo_frame_tag "start_journal_button" do %>
      <%= render partial: 'journals/start_journal_button', locals: { from_all_or_todays: 'todays' } %>
    <% end %>
  </div>

  <%= turbo_frame_tag "due_today_journals_count" do %>
    <%= render partial: "journals/todays_journal_count" %>
  <% end %>

  <%= turbo_frame_tag Journal.new do %>
    <%= render partial: 'journals/empty_state_today', locals: { from_all_or_todays: 'todays' } unless @todays_journals.present? %>
  <% end %>

  <%= turbo_frame_tag "journals" do %>
    <%= render @todays_journals %>
  <% end %>
</div>
