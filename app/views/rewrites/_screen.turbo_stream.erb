<%= turbo_stream.update "entries" do %>
  <%= turbo_frame_tag "compare_results" do %>
    <div class="compare-results">
      <%= render "journals/compared_journal", journal: journal %>
    </div>
  <% end %>
  <%= turbo_frame_tag "rewrite_reading_mode", class: "rewrite-reading-mode" do %>
    <% if rewrite.entries.any? %>
      <%= render ReadingModeButtonComponent.new(journal: rewrite, reading_mode: reading_mode) %>
    <% end %>
  <% end %>
  <% if reading_mode %>
    <% rewrite.entries.each do |entry| %>
      <div class="entry">
        <p>
          <%= simple_format(entry.content) %>
        </p>
      </div>
    <% end %>
  <% else %>
    <%= render partial: "entries/entry",
               collection: rewrite.entries,
               locals: { journal: rewrite, source_tag: source_tag } %>
  <% end %>
<% end %>
<% if rewrite.entries.empty? %>
  <%= turbo_stream.update "new_entry", partial: "entries/empty_state" %>
<% else %>
  <%= turbo_stream.update "new_entry", "" %>
<% end %>
<% if reading_mode %>
  <%= turbo_stream.update "start_entry_button", "" %>
  <%= turbo_stream.update "open_ai_assistant_button", "" %>
  <%= turbo_stream.update "double_check_button", "" %>
  <%= turbo_stream.update "linked_notes_button", "" %>
  <%= turbo_stream.update "compare_button", "" %>
  <%= turbo_stream.update "rewrite_button", "" %>
  <%= turbo_stream.update "previous_queries", "" %>
<% else %>
  <%= turbo_stream.update "start_entry_button" do %>
    <%= render StartEntryButtonComponent.new(journal: rewrite) %>
  <% end %>
  <%= turbo_stream.update "open_ai_assistant_button" do %>
    <%= render OpenAiAssistantButtonComponent.new(journal: rewrite) %>
  <% end %>
  <% if rewrite.entries.any? %>
    <%= turbo_stream.update "double_check_button" do %>
      <%= render DoubleCheckButtonComponent.new(journal: rewrite) %>
    <% end %>
  <% else %>
    <%= turbo_stream.update "double_check_button", "" %>
  <% end %>
  <%= turbo_stream.update "rewrite_button" do %>
    <%= render OriginalJournalButtonComponent.new(journal: journal) %>
  <% end %>
  <%= turbo_stream.update "previous_queries",
                          partial: "journals/previous_queries",
                          locals: { journal: rewrite } %>
<% end %>
<%= turbo_stream.update "ai_assistant", "" %>
<%= turbo_stream.update "close_ai_assistant_button", "" %>
<%= turbo_stream.update "followup_output_ai_assistant", "" %>
<%= turbo_stream.update "reading_mode_button", "" %>
<%= turbo_stream.update "mark_studied_button", "" %>
<%= turbo_stream.update "change_journal_due_date_button", "" %>
