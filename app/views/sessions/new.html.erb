<main class="container">
  <h1><%= t("app_name") %></h1>
  <p><%= t("tagline") %></p>
  <br>
  <%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
  <%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

  <%= form_with url: session_path do |form| %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: t("enter_email"), value: params[:email_address] %><br>
    <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: t("enter_password"), maxlength: 72 %><br>
    <%= form.submit t("sign_in") %>
  <% end %>
  <br>

  <%= link_to t("forgot_password"), new_password_path %>
</main>

