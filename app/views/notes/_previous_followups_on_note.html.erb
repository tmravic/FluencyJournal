<% note.journals.each do |journal| %>
  <%= link_to t("journal.short"),
              for_journal_notes_path(journal_id: journal.id),
              class: "btn btn--journal-short",
              title: journal.title,
              data: { turbo_frame: "notes_box" } %>
<% end %>
<% note.followups.each do |followup| %>
  <%= link_to t("followup.short"),
              followup_path(followup, source_tag: "notes_box"),
              class: "btn btn--primary btn--primary--short",
              data: { turbo_frame: "notes_box" } %>
<% end %>