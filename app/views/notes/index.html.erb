<div class="container">
  <%= turbo_frame_tag "notes_box" do %>
    <div class="notes-box">

      <%= turbo_frame_tag Note.new do %>
        <%= render "notes/empty_state_today" unless @todays_notes.present? %>
      <% end %>

      <%= turbo_frame_tag "note_header" do %>
        <%= render NotesHeaderComponent.new(list: "todays_notes") if @todays_notes.present? %>

        <%= turbo_frame_tag "due_today_notes_count" do %>
          <%= render partial: "notes/todays_notes_count" %>
        <% end %>
    <% end %>

      <%= turbo_frame_tag "notes" do %>

        <% if @todays_notes.present? %>
          <%= render @todays_notes, source_tag: @source_tag %>
        <% end %>

      <% end %>
    </div>
  <% end %>
</div>
