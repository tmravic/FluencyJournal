<div class="container">
  <div class="header">
    <h4>Notes</h4>

    <%= link_to "Make note",
                new_note_path,
                class: "btn btn--primary",
                data: { turbo_frame: dom_id(Note.new) }%>
  </div>

  <%= turbo_frame_tag Note.new %>

  <%= turbo_frame_tag "all_notes" do %>
    <%= render "notes/empty_state" %>
    <%= render @notes %>
  <% end %>
</div>
