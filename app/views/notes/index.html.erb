<div class="container">
  <%= turbo_frame_tag "notes_box" do %>
    <div class="notes_box_scroll">

      <%= turbo_frame_tag Note.new do %>
        <%= render "notes/empty_state" unless @notes.present? %>
      <% end %>

      <%= turbo_frame_tag "notes" do %>

        <%= turbo_frame_tag "note_header" do %>
          <%= render "notes/note_header" if @notes.present? %>
        <% end %>

        <% if @notes.present? %>

          <%= render @notes %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
