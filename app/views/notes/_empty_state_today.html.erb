<div class="empty-state empty-state--only-child">
  <p class="empty-state__text">
    You don't have any notes due today!
  </p>

  <%= render "notes/all_notes_button" %>

  <%= link_to "Add note",
              new_note_path(view_context: "todays_notes"),
              class: "btn btn--primary",
              data: { turbo_frame: dom_id(Note.new) } %>

  <%= render "notes/close_notes_button" %>
</div>
