<div class="note">
  <div class="note__header">
    <%= turbo_frame_tag "note_#{note.id}_category" do %>
      <%= render partial: "notes/note_category", locals: { note: note } %>
    <% end %>

    <div class="note__actions">
      <% unless note.draft_journal? %>
        <%= link_to t("note.actions.journal"),
                    link_journals_note_path(note, from_todays_notes: @todays_notes.present?),
                    class: "btn btn--light",
                    data: { turbo_frame: dom_id(note) } %>

        <% if @todays_notes.present? %>
          <%= button_to t("note.actions.studied"),
                        mark_note_as_studied_note_path(note),
                        form: { data: { turbo_confirm: t("note.actions.studied_warning") } },
                        class: "btn btn--light" %>
        <% else %>
          <span class="note__next_review">
            <%= turbo_frame_tag "next_review_timestamp_#{note.id}" do %>
              <%= render partial: "notes/next_review_timestamp", locals: { note: note } %>
            <% end %>
          </span>

          <%= turbo_frame_tag "change_note_due_date_#{note.id}" do %>
            <%= render partial: "notes/change_note_due_date_button", locals: { note: note } %>
          <% end %>
        <% end %>
      <% end %>

      <%= link_to t("followup.followup"),
                  new_followup_path(
                    class_name: note.class,
                    id: note.id,
                    source_tag: @source_tag,
                    followup_from_todays_notes: @todays_notes.present?
                  ),
                  data: { turbo_frame: "notes_box" },
                  class: "btn btn--light" %>

      <%= link_to t("edit"),
                  edit_note_path(note, update_from_todays_notes: @todays_notes.present?),
                  class: "btn btn--light" %>

      <%= button_to t("delete"),
                    note_path(note, delete_from_todays_notes: @todays_notes.present?),
                    method: :delete,
                    form: { data: { turbo_confirm: t("note.really_delete") } },
                    class: "btn btn--light" %>
    </div>
  </div>
  <p><%= simple_format(note.content) %></p>
  <p><%= simple_format(note.meaning) %></p>
  <p><%= simple_format(note.extras) %></p>
  <% if note.journals.any? || note.followups.any? %>
    <%= render partial: "notes/previous_followups_on_note", locals: { note: note } %>
  <% end %>
</div>