<div class="container">
  <%= turbo_frame_tag "notes_box" do %>
    <div class="notes-box">
      <%= turbo_frame_tag Note.new do %>
        <%= render "notes/empty_state_drafts" unless @draft_notes.present? %>
      <% end %>

      <%= turbo_frame_tag "note_header" do %>
        <%= render "notes/notes_header_drafts" if @draft_notes.present? %>
      <% end %>

      <%= turbo_frame_tag "notes" do %>
        <% if @draft_notes.present? %>
          <%= render @draft_notes, source_tag: @source_tag %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>