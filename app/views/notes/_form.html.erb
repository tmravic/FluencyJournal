<%= simple_form_for note, html: { class: "note form form--stacked" }, data: { turbo: true } do |f| %>
  <%= form_error_notification(note) %>

  <% if automatic %>
    <%= f.input :content, placeholder: t("note.placeholder.content"), input_html: {
      value: render_ai_query_change_content(@ai_query, @ai_output.identifier, @ai_query.prompt.change_keyword, @user, html: false),
      style: "height: 20vh;"
    } %>
    <%= f.input :meaning, placeholder: t("note.placeholder.meaning") %>
    <%= f.input :extras, placeholder: t("note.placeholder.extras") %>
    <%= hidden_field_tag :made_note_from_ai_question, true %>
    <%= hidden_field_tag :ai_query_id, @ai_query.id %>
    <%= hidden_field_tag :ai_output_identifier, @ai_output.identifier %>
  <% else %>
    <%= f.input :content, placeholder: t("note.placeholder.content") %>
    <%= f.input :meaning, placeholder: t("note.placeholder.meaning_optional") %>
    <%= f.input :extras, placeholder: t("note.placeholder.extras") %>
  <% end %>

  <%= hidden_field_tag :view_context, view_context if local_assigns[:view_context] %>
  <%= hidden_field_tag :update_from_todays_notes, @update_from_todays_notes if @update_from_todays_notes %>

  <div class="form__actions">
    <%= f.select :category, note_category_options,
                 { selected: automatic ? "vocab" : note.category } %>
    <%= link_to t("cancel"), determine_cancel_path, class: "btn btn--light", data: { turbo_frame: "notes_box" } %>
    <%= f.submit class: "btn btn--secondary" %>
  </div>
<% end %>
