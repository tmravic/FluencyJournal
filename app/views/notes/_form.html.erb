<%= simple_form_for note, html: { class: "note form" }, data: { turbo: true } do |f| %>
  <%= form_error_notification(note) %>

  <% if automatic %>
    <%= f.input :content, input_html: {
      value: render_ai_query_change_content(@ai_query, @ai_output.identifier, @ai_query.prompt.change_keyword, html: false),
      style: "height: 20vh;"
    } %>
    <%= hidden_field_tag :made_note_from_ai_question, true %>
    <%= hidden_field_tag :ai_query_id, @ai_query.id %>
    <%= hidden_field_tag :ai_output_identifier, @ai_output.identifier %>
  <% else %>
    <%= f.input :content %>
  <% end %>

  <%= hidden_field_tag :view_context, view_context if local_assigns[:view_context] %>
  <%= hidden_field_tag :update_from_todays_notes, @update_from_todays_notes if @update_from_todays_notes %>

  <div class="form__input__button_block">
    <% if automatic %>
      <%= f.select :category, Note.categories.keys.map { |key| [ key.humanize, key ] },
                   { selected: 'automatic' } %>
    <% else %>
      <%= f.select :category, hide_automatic_notes_option %>
    <% end %>
    <%= link_to "Cancel", notes_path, class: "btn btn--light", data: { turbo_frame: "notes_box" } %>
    <%= f.submit class: "btn btn--secondary" %>
  </div>
<% end %>
