<div class="container">
  <%= turbo_frame_tag "notes_box" do %>
    <div class="notes-box">

      <%= turbo_frame_tag Note.new do %>
        <%= render "notes/empty_state" unless @all_notes.present? %>
      <% end %>

      <%= turbo_frame_tag "note_header" do %>
        <%= render "notes/notes_header_all" if @all_notes.present? %>
      <% end %>

      <%= turbo_frame_tag "notes" do %>

        <% if @all_notes.present? %>
          <%= render @all_notes, source_tag: @source_tag %>
        <% end %>

      <% end %>
    </div>
  <% end %>
</div>
