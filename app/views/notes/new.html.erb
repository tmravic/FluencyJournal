<% content_for :title, t("note.new_title") %>
<div class="container">
  <%= back_link t("note.back_to_notes"), notes_path %>

  <div class="header">
    <h1><%= t("note.new_title") %></h1>
  </div>

  <%= turbo_frame_tag @note do %>
    <%= render "form", note: @note, view_context: @view_context, automatic: false %>
  <% end %>
</div>
