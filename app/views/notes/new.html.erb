<% content_for :title, "New note" %>
<div class="container">
  <%= link_to sanitize("&larr; #{t("note.back_to_notes")}"), notes_path %>

  <div class="header">
    <h1>New note</h1>
  </div>

  <%= turbo_frame_tag @note do %>
    <%= render "form", note: @note, view_context: @view_context, automatic: false %>
  <% end %>
</div>
