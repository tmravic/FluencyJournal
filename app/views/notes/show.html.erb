<div class="container">
  <p style="color: green"><%= notice %></p>

  <%= render 'notes/note', note: @note %>

  <div>
    <%= link_to "Edit this note", edit_note_path(@note) %>
    <%= link_to "Back to notes", notes_path %>

    <%= button_to "Destroy this note", @note, method: :delete, data: { turbo_frame: "notes_box", turbo_stream: true } %>
  </div>
</div>
