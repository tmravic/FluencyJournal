<div class="container">
  <%= render 'notes/note', note: @note %>

  <div>
    <%= link_to t("note.edit_this"), edit_note_path(@note) %>
    <%= link_to t("note.back_to_notes"), notes_path %>

    <%= button_to t("note.destroy_this"), @note, method: :delete, data: { turbo_frame: "notes_box", turbo_stream: true } %>
  </div>
</div>
