<%= turbo_stream.remove @note %>
<% if @todays_notes_empty %>
  <%= turbo_stream.update "new_note", partial: "notes/empty_state_today" %>
  <%= turbo_stream.update "note_header", "" %>
<% end %>
<%= turbo_stream.update "due_today_notes_count",
                        partial: "notes/todays_notes_count" %>
<%= render_turbo_stream_flash_messages %>
