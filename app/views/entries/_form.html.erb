<!--Entry form-->

<%= simple_form_for [journal, entry], html: { class: "form entry" } do |f| %>
  <%= form_error_notification(entry) %>

  <%= f.input :content, html5: true, placeholder: "Write your journal here one small piece at a time.", style: "font-size:11px;" %>

  <div class="form__input__button_block">
    <%= link_to "Cancel", journal_path(journal), class: "btn btn--light" %>
    <%= f.submit class: "btn btn--secondary", name: nil %>
  </div>
<% end %>
