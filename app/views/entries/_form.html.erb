<!--Entry form-->

<%= simple_form_for [journal, entry], html: { class: "form entry" } do |f| %>
  <%= form_error_notification(entry) %>

  <%= f.input :content,
              html5: true,
              placeholder: t('simple_form.placeholders.entry.content') %>

  <div class="form__input__button_block">
    <%= link_to t("cancel"),
                journal_path(journal, cancel: true),
                class: "btn btn--light",
                data: { turbo_frame: dom_id(@entry), turbo_stream: true } %>
    <%= f.submit class: "btn btn--secondary", name: nil %>
  </div>
<% end %>
