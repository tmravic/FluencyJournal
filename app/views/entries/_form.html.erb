<%= simple_form_for entry, html: { class: "entry form" } do |f| %>
  <% if entry.errors.any? %>
    <div class="error-message">
      <h3><%= pluralize(entry.errors.count, "error") %> prohibited this entry from being saved:</h3>
      <%= entry.errors.full_messages.to_sentence.capitalize %>
    </div>
  <% end %>
  <%= f.input :title, input_html: { autofocus: true } %>
  <%= f.input :content, input_html: { autofocus: true } %>
  <!--Think I need accepts_nested_attributes_for commit-->
  <!--And to target a Turbo Frame on the commits/new page-->
  <!--which itself renders the ai_request form-->
  <%= f.submit class: "btn btn--secondary" %>
<% end %>
