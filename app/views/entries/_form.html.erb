<%= simple_form_for entry, html: { class: "entry form" }, data: { turbo: true } do |f| %>
  <%= form_error_notification(entry) %>

  <%= f.input :title, input_html: { autofocus: true } %>

  <%= link_to "Cancel", entries_path, class: "btn btn--light" %>
  <%= f.submit class: "btn btn--secondary" %>
<% end %>
