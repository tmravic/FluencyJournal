<div class="header">
  <h3><%= @entry.title %></h3>
</div>

<% @entry.ai_queries.each do |query| %>
  <button><%= query.id %></button>
<% end %>
<!--I want a method called show_previous_query-->
<!--which opens the journal partial with that query's data-->

<%= turbo_frame_tag Commit.new do %>
  <%= render 'commits/empty_state' unless @commits.present? %>
<% end %>

<%= turbo_frame_tag "commits" do %>
  <% if @commits.present? %>
    <%= render 'commits/empty_state' %>
    <%= render @commits, entry: @entry %>
  <% end %>
<% end %>

<%= turbo_frame_tag "journal" %>
<br>

<%= link_to "Start commit",
            new_entry_commit_path(@entry),
            class: "btn btn--primary",
            data: { turbo_frame: dom_id(Commit.new), turbo_stream: true } %>
<br>
