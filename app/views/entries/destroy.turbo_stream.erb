<%= turbo_stream.remove @entry %>
<% if @entries.empty? %>
  <%= turbo_stream.update "entries" do %>
    <%= render 'entries/empty_state' %>
  <% end %>
  <%= turbo_stream.update "quiz_buttons", '' %>
  <%= turbo_stream.update "reading_mode_button", '' %>
  <%= turbo_stream.update "double_check_button", '' %>
<% end %>
<%= turbo_stream.update "character_count", partial: 'journals/character_count', locals: { journal: @journal } %>
<%= render_turbo_stream_flash_messages %>