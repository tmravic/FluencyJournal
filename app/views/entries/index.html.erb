<% content_for :title, "Entries" %>

<%= turbo_stream_from current_group, "entries" %>

<div class="container">

  <%= turbo_frame_tag "all_notes" %>

  <%= turbo_frame_tag "workspace" %>

  <div class="header">
    <h1>Entries</h1>

    <%= turbo_frame_tag "close_entry_button" %>

    <%= link_to "Start entry",
                new_entry_path,
                class: "btn btn--primary btn--primary--manage-entry",
                data: { turbo_frame: dom_id(Entry.new) }%>
  </div>

  <%= turbo_frame_tag Entry.new %>

  <%= turbo_frame_tag "entries" do %>
    <%= render "entries/empty_state" %>
    <%= render @entries %>
  <% end %>
</div>
