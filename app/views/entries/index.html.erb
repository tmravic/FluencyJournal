<% content_for :title, "Entries" %>

<%= turbo_stream_from "entries" %>

<div class="container">
  <div class="header">
    <h1>Entries</h1>
    <%= link_to "New entry",
                new_entry_path,
                class: "btn btn--primary",
                data: { turbo_frame: dom_id(Entry.new) }%>
  </div>

  <%= turbo_frame_tag Entry.new %>

  <%= turbo_frame_tag "entries" do %>
    <%= render @entries %>
  <% end %>
</div>
