<% content_for :title, t("entry.new_title") %>

<main class="container">
  <%= link_to sanitize("&larr; #{t("entry.back_to_journal")}"), journal_path(@journal) %>

  <div class="header">
    <h1><%= t("entry.new_title") %></h1>
  </div>

  <%= turbo_frame_tag @entry do %>
    <%= render "form", journal: @journal, entry: @entry %>
  <% end %>
</main>
