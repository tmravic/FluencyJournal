<% content_for :title, t("entry.editing_title") %>

<main class="container">
  <%= back_link t("entry.back_to_journal"), journal_path(@journal) %>

  <div class="header">
    <h1><%= t("entry.editing_title") %></h1>
  </div>

  <%= turbo_frame_tag @entry do %>
    <%= render "form", journal: @journal, entry: @entry %>
  <% end %>
</main>
