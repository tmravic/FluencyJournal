<%= turbo_stream.update Entry.new, "" %>
<%= turbo_stream.update "start_entry_button", partial: 'entries/start_entry_button' %>
<%= turbo_stream.update "mark_studied_button", partial: 'journals/mark_studied_button', locals: { journal: @journal } %>
<%= turbo_stream.update "quiz_buttons", partial: 'quizzes/quiz_buttons' %>
<%= turbo_stream.append "entries", partial: "entries/entry", locals: { entry: @entry, journal: @journal, source_tag: @source_tag } %>
<%= render_turbo_stream_flash_messages %>
