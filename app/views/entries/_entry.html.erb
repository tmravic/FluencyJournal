<%= turbo_frame_tag entry do %>
  <div class="entry">
    <%= link_to entry.title,
                entry_path(entry),
                data: { turbo_frame: "_top" } %>
    <%= entry.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
    <div class="entry__actions">
      <%= link_to "Edit",
                  edit_entry_path(entry),
                  data: { turbo: true },
                  class: "btn btn--light" %>
      <%= button_to "Delete",
                    entry_path(entry),
                    method: :delete,
                    data: { turbo: true },
                    class: "btn btn--light" %>
    </div>
  </div>
<% end %>