<% source_tag = local_assigns[:source_tag] || @source_tag %>
<%= turbo_frame_tag entry do %>
  <div class="entry">
    <div class="entry__header">
      <h2 class="entry__title">
        <%= t('entry.entry', number: entry.entry_number) %>
      </h2>

      <span class="entry__date"><%= local_date(entry.created_at, format: "%Y-%m-%d") %></span>

      <div class="entry__actions">
        <button type="button"
                class="btn btn--light"
                data-controller="tts"
                data-tts-url-value="<%= speak_journal_entry_path(journal, entry) %>"
                data-action="click->tts#play">
          <%= t("entry.listen") %>
        </button>
        <%= link_to t('followup.followup'),
                    new_followup_path(
                      class_name: entry.class,
                      id: entry.id,
                      source_tag: source_tag
                    ),
                    data: {
                      turbo_frame: followup_turbo_frame(source_tag),
                      controller: "scroll",
                      action: "click->scroll#scrollToTarget",
                      scroll_target_value: followup_turbo_frame(source_tag)
                    },
                    class: "btn btn--light" %>
        <%= link_to t("edit"),
                    [:edit, journal, entry],
                    class: "btn btn--light",
                    data: { turbo_frame: dom_id(entry) } %>
        <%= button_to t("delete"),
                      [journal, entry],
                      method: :delete,
                      form: { data: { turbo_confirm: t("entry.really_delete") } },
                      class: "btn btn--light" %>
      </div>
    </div>
    <p><%= simple_format(entry.content) %></p>
  </div>
<% end %>
