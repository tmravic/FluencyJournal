<%= turbo_frame_tag "ai_assistant" do %>
  <div class="container">
    <br>

    <div style="display:flex;justify-content:space-evenly">
      <label for="original_language_prompt">Original Language:</label>
      <label for="learning_language_prompt">Learning Language:</label>
    </div>
    <div style="margin-left:5px">
      <textarea id="original_language_prompt"
                placeholder="Type your journal journal in your native language to confirm its meaning."
                style="height:100px;width:48%;padding:3px;margin:1px;font-size:12px;"
                readonly><%= @prompt.original_language if @prompt %></textarea>

      <textarea id="learning_language_prompt"
                placeholder="Type your journal journal in the language you're studying."
                style="height:100px;width:48%;padding:3px;margin:1px;font-size:12px;"
                readonly><%= @prompt.learning_language if @prompt %></textarea>
    </div>

    <br>

    <div class="card">
      <div class="card__change__title">
        <h4>Corrected text</h4>
        <%= button_to "Delete AI Question",
                    journal_ai_query_path(@ai_query.journal, @ai_query),
                    method: :delete,
                    data: { turbo_stream: true },
                    class: "btn btn--light" %>
      </div>
      <%= content_tag(:div, @ai_query.corrected_text) %>

      <% @ai_query.count_changes.times do |i| %>
        <hr> <!------------>
        <div class="card__change">
          <div class="card__change__title">
            <h4><%= "Change #{i + 1}" %></h4>
            <div>
              <%= link_to "Followup",
                          new_journal_path,
                          class: "btn btn--secondary" %>
              <%= turbo_frame_tag "make_note_button" do %>
                <% unless @ai_query.made_note %>
                  <%= link_to "Make note",
                              new_automatic_notes_path(
                                ai_query_id: @ai_query.id,
                                change_content_number: i
                              ),
                              class: "btn btn--primary",
                              data: {
                                turbo_stream: true,
                                controller: "scroll",
                                action: "click->scroll#scrollToTop"
                              } %>
                <% end %>
              <% end %>
            </div>
          </div>
          <div class="card__change_content">
            <%= render_ai_query_change_content(@ai_query, i, html: true) %>
          </div>
        </div>
      <% end %>
      <br>
    </div>
  </div>
<% end %>
