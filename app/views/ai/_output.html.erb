<br>
<div class="card">
  <% if generated_idea %>
    <p>Corrected text</p>
    <%= content_tag(:div, generated_idea) %>
  <% end %>

  <% if change_list.present? && change_list != 'Processing...' %>
    <% jq = JournalQuery.find(change_list) %>
    <% jq.count_changes.times do |i| %>
      <hr> <!------------>
      <p><%= "Change #{i + 1}" %></p>
      <%= content_tag(:div, jq.change_content(i + 1)) %>
      <%= content_tag(:div) do %>
        <%= "(#{jq.change_explanation_en(i + 1)})" %>
      <% end %>
    <% end %>
  <% end %>
  <br>
</div>
