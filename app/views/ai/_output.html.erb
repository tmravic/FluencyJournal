<br>
<div class="card">
  <% if generated_idea %>
    <h4>Corrected text</h4>
    <div><%= generated_idea %></div>
  <% elsif change_list == "Processing..." %>
    <h4><%= change_list %></h4>
  <% end %>

  <% if change_list.present? && change_list != "Processing..." %>
    <% jq = JournalQuery.find(change_list) %>
    <% jq.count_changes.times do |i| %>
      <hr>
      <div class="card__change">
        <div class="card__change__title">
          <h4><%= "Change #{i + 1}" %></h4>
          <div>
            <%= link_to "Followup", new_journal_path, class: "btn btn--secondary" %>
            <%= turbo_frame_tag "make_note_button" do %>
              <% unless jq.made_note %>
                <%= link_to "Make note",
                            new_automatic_notes_path(
                              ai_query_id: jq.id,
                              change_content_number: i
                            ),
                            class: "btn btn--primary",
                            data: {
                              turbo_stream: true,
                              controller: "scroll",
                              action: "click->scroll#scrollToTop"
                            } %>
              <% end %>
            <% end %>
          </div>
        </div>
        <div class="card__change_content">
          <%= render_ai_query_change_content(jq, i, html: false) %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
