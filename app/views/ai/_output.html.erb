<br>
<% jq = JournalQuery.find(change_list) if change_list.present? && change_list != "Processing..." %>
<% corrected_text_output = jq.ai_outputs.last if jq %>
<div class="card">
  <% if generated_idea.present? %>
    <%= turbo_frame_tag "change_#{corrected_text_output.identifier}" do %>
      <div class="card__change__title">
        <h4>Corrected text</h4>
        <div>
          <%= button_to "Delete",
                        ai_output_path(corrected_text_output.id),
                        method: :delete,
                        data: { turbo_stream: true },
                        class: "btn btn--light" %>
          <%= link_to "Followup",
                      new_journal_path,
                      class: "btn btn--secondary" %>
          <% unless jq && corrected_text_output.made_note %>
            <%= turbo_frame_tag "make_note_button_#{corrected_text_output.identifier}" do %>
              <%= link_to "Note",
                          new_automatic_notes_path(
                            ai_query_id: jq.id,
                            ai_output_id: corrected_text_output.id
                          ),
                          class: "btn btn--primary",
                          data: {
                            turbo_stream: true,
                            controller: "scroll",
                            action: "click->scroll#scrollToTop"
                          } %>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="card__change__corrected">
        <%= generated_idea %>
      </div>
    <% end %>
  <% elsif change_list == "Processing..." %>
    <h4><%= change_list %></h4>
  <% else %>
    <h4>AI Output</h4>
  <% end %>
  <% if jq %>
    <% jq.ai_outputs.each do |output| %>
      <% next if output == corrected_text_output %>
      <hr>
      <%= turbo_frame_tag "change_#{output.identifier}" do %>
        <div class="card__change">
          <div class="card__change__title">
            <h4><%= "Change #{output.identifier}" %></h4>
            <div>
              <%= button_to "Delete",
                            ai_output_path(output.id),
                            method: :delete,
                            data: { turbo_stream: true },
                            class: "btn btn--light" %>
              <%= link_to "Followup",
                          new_followup_path,
                          class: "btn btn--secondary" %>
              <% unless output.made_note %>
                <%= turbo_frame_tag "make_note_button_#{output.identifier}" do %>
                  <%= link_to "Note",
                              new_automatic_notes_path(
                                ai_query_id: jq.id,
                                ai_output_id: output.id
                              ),
                              class: "btn btn--primary",
                              data: {
                                turbo_stream: true,
                                controller: "scroll",
                                action: "click->scroll#scrollToTop"
                              } %>
                <% end %>
              <% end %>
            </div>
          </div>
          <div class="card__change_content">
            <%= render_ai_query_change_content(jq, output.identifier, html: true) %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
