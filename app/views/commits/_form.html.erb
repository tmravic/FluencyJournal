<%= form_with(model: commit) do |form| %>
  <% if commit.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(commit.errors.count, "error") %> prohibited this commit from being saved:</h2>

      <ul>
        <% commit.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :content, style: "display: block" %>
    <%= form.textarea :content %>
  </div>

  <div>
    <%= form.label :entry_id, style: "display: block" %>
    <%= form.text_field :entry_id %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
