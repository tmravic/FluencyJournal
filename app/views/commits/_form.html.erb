<!--Commit form-->

<%= simple_form_for [entry, commit], html: { class: "form commit" } do |f| %>
  <%= form_error_notification(commit) %>

  <%= f.input :content, html5: true, input_html: { autofocus: true } %>

  <div class="form__input__button_block">
    <%= link_to "Cancel", entry_path(entry), class: "btn btn--light",
                data: { turbo_method: :get, turbo_frame: "new_commit" } %>
    <%= f.submit class: "btn btn--secondary", name: nil %>
  </div>
<% end %>
