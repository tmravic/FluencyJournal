<%= turbo_frame_tag commit do %>
  <div class="commit">
    <div class="commit__header">
      <h2 class="commit__title">
        Commit <%= commit.commit_number %>
      </h2>

      <div class="commit__actions">
        <%= link_to "Edit",
                    [:edit, entry, commit], # edit_entry_commit_path(entry, commit)
                    class: "btn btn--light" %>
        <%= button_to "Delete",
                      [entry, commit],
                      method: :delete,
                      form: { data: { turbo_confirm: "Are you sure?" } },
                      class: "btn btn--light" %>
      </div>
    </div>
    <p><%= commit.content %></p>
  </div>
<% end %>
