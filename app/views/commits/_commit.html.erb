<%= turbo_frame_tag commit do %>
  <div class="commit">
    <div class="commit__header">
      <h2 class="commit__title">
        Commit <%= commit.commit_number %>
      </h2>

      <div class="commit__actions">
        <%= link_to "Edit",
                    [:edit, journal, commit], # edit_journal_commit_path(journal, commit)
                    class: "btn btn--light" %>
        <%= button_to "Delete",
                      [journal, commit],
                      method: :delete,
                      form: { data: { turbo_confirm: "Really delete this commit?" } },
                      class: "btn btn--light" %>
      </div>
    </div>
    <p><%= commit.content %></p>
  </div>
<% end %>
