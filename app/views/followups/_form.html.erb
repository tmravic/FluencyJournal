<%= turbo_frame_tag "followup_output_#{@source_tag}" do %>
  <div data-controller="scroll" data-scroll-on-connect-value="true">
  <%= simple_form_for [followup], html: { class: "form followup" } do |f| %>
    <%= form_error_notification(followup) %>

    <%= f.fields_for :followup_prompt do |followup_prompt| %>
      <%= followup_prompt.label t('followup.followup_question') %>
      <div data-controller="template-prompt-select">
        <%= followup_prompt.text_area :base_content,
                                      data: { template_prompt_select_target: "textarea" },
                                      html5: true,
                                      placeholder: t('followup.placeholder') %>
        <%= render partial: 'followup_template_prompts/template_select',
        locals: {
          followup_template_prompts: @followup_template_prompts
        } %>
      </div>
      <%= followup_prompt.label t('followup.reference_text') %>
      <%= followup_prompt.text_area :user_generated_content,
                                    html5: true,
                                    class: 'form__actions',
                                    value: @reference_text %>
      <%= followup_prompt.hidden_field :uuid, value: @uuid %>
      <% model_options = [
        [t("ai_query.model.fast"), "grok-4-fast-non-reasoning"],
        [t("ai_query.model.higher_quality"), "grok-4.6"]
      ] %>
      <%= followup_prompt.select :ai_model,
                                 options_for_select(model_options, "grok-4-fast-non-reasoning") %>
    <% end %>

    <% if @followup_origin.present? %>
      <% origin_class = @followup_origin.class %>
      <% origin_id    = @followup_origin.id.presence || "" %>
    <% else %>
      <% Rails.logger.error "FOLLOWUPS_FORM: @followup_origin was nil when rendering form! This must be set by FollowupsController#new before any render. class_name=#{params[:class_name].inspect}" %>
      <% origin_class = "Unknown" %>
      <% origin_id    = 0 %>
    <% end %>
    <%= f.hidden_field :followup_origin_class, value: origin_class %>
    <%= f.hidden_field :followup_origin_id, value: origin_id %>
    <%= hidden_field_tag "followup[journal_id]", @journal.id if @journal %>
    <%= f.hidden_field :source_tag, value: @source_tag %>

    <div class="form__actions">
      <%= render_correct_cancel_button %>
      <%= f.submit class: "btn btn--secondary", data:
        {
          turbo_stream: true,
          controller: "scroll",
          action: "click->scroll#scrollToTarget",
          scroll_target_value: "followup_output_#{@source_tag}"
        } %>
    </div>
  <% end %>
  </div>
<% end %>
