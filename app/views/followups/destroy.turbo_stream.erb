<% if @journal # deleting from the ai_assistant %>
  <%= turbo_stream.update "previous_queries", partial: "journals/previous_queries", locals: { journal: @journal } %>
  <% @display_frames.each do |frame| %>
    <%= turbo_stream.update frame, "" %>
  <% end %>
<% else # deleting from the notes_box %>
  <%= turbo_stream.update "notes_box" do %>
    <div class="notes-box">
      <%= turbo_frame_tag Note.new %>
      <% @todays_notes = Current.user&.notes.next_to_study %>
      <%= turbo_frame_tag "note_header" do %>
        <%= render NotesHeaderComponent.new(list: "todays_notes") if @todays_notes.present? %>
      <% end %>
      <%= turbo_frame_tag "notes" do %>
        <% if @todays_notes.present? %>
          <%= render @todays_notes %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
