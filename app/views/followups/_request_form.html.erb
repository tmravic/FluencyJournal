<div class="request_form">
  <div>
    <label for="base_content">
      <%= t("followup.followup_question") %>
    </label>
    <textarea id="base_content" readonly><%= followup.prompt.base_content %></textarea>
  </div>

  <div>
    <label for="user_generated_content">
      <%= t('followup.reference_text') %>
    </label>
    <textarea id="user_generated_content" readonly><%= followup.prompt.user_generated_content %></textarea>
  </div>
  <div class="followup__request_form">
    <% if followup.origin.is_a?(Note) %>
      <%= button_to t("followup.delete_followup"),
                    followup_path(followup, source_tag: source_tag),
                    method: :delete,
                    data: { turbo_stream: true },
                    class: "btn btn--light" %>
      <%= link_to t("note.back_to_notes"),
                    notes_path,
                    data: { turbo_frame: "notes_box" },
                    class: "btn btn--dark" %>
    <% else %>
      <%= button_to t("followup.delete_followup"),
                    followup_path(
                      followup,
                      source_tag: source_tag,
                      journal: followup.origin&.journal,
                      display_frame: display_frame
                    ),
                    method: :delete,
                    data: { turbo_stream: true },
                    class: "btn btn--light", id: "send_button" %>
      <%= close_followup_button(source_tag: source_tag) %>
    <% end %>
  </div>
</div>
