<!--QuizAnswer form-->
<%= simple_form_for [journal, quiz, quiz_answer],
                    html: {
                      data: {
                        turbo_frame: quiz_answer.ai_output,
                        controller: "quiz-draft",
                        quiz_draft_output_id_value: quiz_entry.id,
                        action: "submit->quiz-draft#clear"
                      },
                      class: "form entry"
                    } do |f| %>
  <%= form_error_notification(quiz_answer) %>

  <%= f.input :user_response,
              html5: true,
              placeholder: t("quiz_answer.try_to_answer", language: journal.user.learning_language),
              input_html: { data: { quiz_draft_target: "input" } } %>
  <%= f.hidden_field :ai_output_id %>
  <% answer_entry = quiz_answer_entry(journal, quiz_entry) %>
  <div class="form__actions">
    <%= f.submit t("quiz_answer.submit_answer"), class: "btn btn--secondary", name: nil %>
    <%= turbo_frame_tag "show_hint_button_#{quiz_entry.id}" do %>
      <%= render "quiz_answers/show_hint_button", journal:, quiz:, quiz_entry: %>
    <% end %>
    <%= turbo_frame_tag "show_original_language_button_#{quiz_entry.id}" do %>
      <%= link_to t("quiz_answer.show_original_language", language: journal.user.original_language),
                  show_original_language_journal_quiz_path(journal, quiz, ai_output_id: quiz_entry.id),
                  data: { turbo_stream: true },
                  class: "btn btn--light"
      %>
    <% end %>

    <%= link_to t("quiz_answer.peek"),
                peek_journal_quiz_path(journal, quiz, ai_output_id: quiz_entry.id),
                data: {
                  turbo_stream: true,
                  turbo_confirm: t("quiz_answer.peek_warning"),
                  action: "click->quiz-draft#save"
                },
                class: "btn btn--light" %>
    <% if answer_entry %>
      <button type="button"
              class="btn btn--light"
              data-controller="tts"
              data-tts-url-value="<%= speak_journal_entry_path(journal, answer_entry) %>"
              data-action="click->tts#play">
        <%= t("entry.listen") %>
      </button>
    <% end %>
  </div>
<% end %>
