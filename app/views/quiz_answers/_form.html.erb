<!--QuizAnswer form-->
<%= simple_form_for [journal, quiz, quiz_answer],
                    html: {
                      data: { turbo_frame: quiz_answer.ai_output },
                      class: "form entry"
                    } do |f| %>
  <%= form_error_notification(quiz_answer) %>

  <%= f.input :user_response,
              html5: true,
              placeholder: t("quiz_answer.try_to_answer", language: journal.user.learning_language) %>
  <%= f.hidden_field :ai_output_id %>
  <%= f.hidden_field :identifier, value: quiz_entry.identifier %>
  <div class="form__input__button_block">
    <%= f.submit t("quiz_answer.check_answer"), class: "btn btn--secondary", name: nil %>
    <%= link_to t("quiz_answer.peek"),
                peek_journal_quizzes_path(quiz.journal, ai_output: quiz_entry, quiz_id: quiz),
                data: { turbo_stream: true, turbo_confirm: t("quiz_answer.peek_warning") },
                class: "btn btn--light" %>
  </div>
<% end %>
