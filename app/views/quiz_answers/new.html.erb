<% content_for :title, t("quiz_answer.new_title") %>

<main class="container">
  <%= link_to sanitize("&larr; #{t("quiz_answer.back_to_journal")}"), journal_path(@journal) %>

  <div class="header">
    <h1><%= t("quiz_answer.new_title") %></h1>
  </div>

  <%= turbo_frame_tag "ai_output_#{@ai_output.id}_quiz_answer_#{dom_id(@quiz_answer)}" do %>
    <%= render "form",
               journal: @journal,
               quiz_answer: @quiz_answer %>
  <% end %>
</main>
