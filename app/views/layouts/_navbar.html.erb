<header class="navbar">
  <% if Current.user %>
<!--    <div class="navbar__group">-->
      <%#= "Group: #{current_group.name}" %>
        <!--Member count: -->
<!--    </div>-->

    <div class="navbar__languages">
      <%= "#{Current.user.original_language} → #{Current.user.learning_language}" %>
    </div>


    <div class="navbar__name">
      <%= Current.user.name %>
    </div>

    <%= link_to "Notes",
                new_entry_path,
                class: "btn btn--primary navbar__notes_button" %>

    <%= button_to "Logout",
                  session_path,
                  method: :delete,
                  class: "btn btn--dark navbar__right" %>
  <% else %>
    <%= link_to "Sign in",
                new_session_path,
                class: "btn btn--dark navbar__right" %>
  <% end %>
</header>
