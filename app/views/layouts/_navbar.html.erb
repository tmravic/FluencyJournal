<header class="navbar">
  <% if Current.user %>
<!--    <div class="navbar__group">-->
      <%#= "Group: #{current_group.name}" %>
        <!--Member count: -->
<!--    </div>-->

    <div class="navbar__languages">
      <%= generate_original_and_learning_language %>
    </div>


    <div class="navbar__name">
      <%= Current.user.name %>
    </div>


  <%= link_to t("note_button"),
              notes_path,
              data: { turbo_frame: "notes_box" },
              class: "btn btn--primary navbar__notes-button" %>

    <button type="button"
            data-controller="theme"
            data-action="click->theme#toggle"
            class="btn btn--light theme-toggle"
            aria-label="<%= t("toggle_dark_mode") %>">
      <span data-theme-target="icon">🌙</span>
    </button>

    <%= button_to t('logout'),
                  session_path,
                  method: :delete,
                  class: "btn btn--dark navbar__right" %>
  <% else %>
    <button type="button"
            data-controller="theme"
            data-action="click->theme#toggle"
            class="btn btn--light theme-toggle"
            aria-label="<%= t("toggle_dark_mode") %>">
      <span data-theme-target="icon">🌙</span>
    </button>

    <%= link_to t('sign_in'),
                new_session_path,
                class: "btn btn--dark navbar__right" %>
  <% end %>
</header>
