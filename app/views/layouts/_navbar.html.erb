<header class="navbar">
  <% if Current.user %>
    <div class="navbar__brand">
      <%= "Current group: #{current_group.name}" %>
        <!--Member count: -->
    </div>

    <div class="navbar__name">
      <%= Current.user.name %>
    </div>
    <%= button_to "Logout",
                  session_path,
                  method: :delete,
                  class: "btn btn--dark" %>
  <% else %>
    <%= link_to "Sign in",
                new_session_path,
                class: "btn btn--dark navbar__right" %>
  <% end %>
</header>
