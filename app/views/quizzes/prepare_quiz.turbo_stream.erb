<%= turbo_stream.update "quiz_buttons" do %>
  <%= render ResetQuizButtonComponent.new(journal: @journal) %>
<% end %>
<%= turbo_stream.replace "entries" do %>
  <%= turbo_frame_tag "quizzes" do %>
    <%= turbo_stream_from "channel_#{@uuid}" %>
    <%= render partial: "quizzes/output", locals: { ai_query_id: @ai_query_id } %>
  <% end %>
<% end %>
<%= turbo_stream.update "ai_assistant", partial: "quizzes/ai_assistant" %>
<%= turbo_stream.update "start_entry_button", "" %>
<%= turbo_stream.update "reading_mode_button", "" %>
<%= turbo_stream.update "open_ai_assistant_button", "" %>
<%= turbo_stream.update "close_ai_assistant_button", "" %>
<%= turbo_stream.update "mark_studied_button", "" %>
<%= turbo_stream.update "change_journal_due_date_button", '' %>
<%= turbo_stream.update "double_check_button", '' %>
<%= turbo_stream.update "linked_notes_button", '' %>
<%= turbo_stream.update "compare_button", '' %>
<%= turbo_stream.replace "previous_queries" do %>
  <%= turbo_frame_tag "grade_quiz_button" %>
<% end %>
