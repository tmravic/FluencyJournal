<%= turbo_frame_tag @quiz_entry_frame do %>
  <div class="entry">
    <p>
      <%= entry_content %>
    </p>
  </div>
  <%= link_to "Go back", unpeek_journal_quizzes_path(journal, frame: @quiz_entry_frame, quiz_id: @quiz),
              class: "btn btn--secondary",
              style: "margin: var(--space-xxs) 0",
              data: { turbo_stream: true }
  %>
<% end %>
