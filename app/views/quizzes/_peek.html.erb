<div class="entry">
  <div class="entry__header">
    <h2 class="entry__title">
      <%= t("entry.entry", number: identifier) %>
    </h2>
  </div>
  <p>
    <%= entry_content %>
  </p>
</div>
<div class="form__input__button_block" style="margin: var(--space-xxs) 0">
  <% if entry %>
    <button type="button"
            class="btn btn--light"
            data-controller="tts"
            data-tts-url-value="<%= speak_journal_entry_path(journal, entry) %>"
            data-action="click->tts#play">
      <%= t("entry.listen") %>
    </button>
  <% end %>
  <%= link_to t("go_back"),
              unpeek_journal_quiz_path(journal, @quiz, ai_output_id: @ai_output.id),
              class: "btn btn--secondary",
              data: { turbo_stream: true } %>
</div>
