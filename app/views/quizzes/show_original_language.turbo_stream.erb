<%= turbo_stream.update "original_language_entry_#{@quiz_entry.id}" do %>
  <p><%= simple_format(@quiz_entry.content) %></p>
<% end %>

<%= turbo_stream.update "show_original_language_button_#{@quiz_entry.id}" do %>
  <%= link_to t("quiz_answer.hide_original_language", language: @journal.user.original_language),
              hide_original_language_journal_quiz_path(@journal, @quiz, ai_output_id: @quiz_entry.id),
              data: { turbo_stream: true },
              class: "btn btn--light" %>
<% end %>
