<%= turbo_frame_tag "ai_assistant" do %>
  <div class="card">
    <% if @corrected_text_output %>
      <%= turbo_frame_tag "#{@prompt.change_keyword}#{@corrected_text_output.identifier}" do %>
        <div class="change__title">
          <h4><%= t("ai_query.corrected_text") %></h4>
          <div>
            <%= button_to t("delete"),
                          ai_output_path(@corrected_text_output.id),
                          method: :delete,
                          data: { turbo_stream: true },
                          class: "btn btn--light" %>
            <%= link_to t('followup.followup'),
                        new_followup_path(
                          class_name: @corrected_text_output.class,
                          id: @corrected_text_output.id,
                          source_tag: @source_tag
                        ),
                        data: {
                          turbo_frame: followup_turbo_frame(@source_tag),
                          controller: "scroll",
                          action: "click->scroll#scrollToTarget",
                          scroll_target_value: followup_turbo_frame(@source_tag)
                        },
                        class: "btn btn--secondary" %>
            <% unless @corrected_text_output.made_note %>
              <%= turbo_frame_tag "make_note_button_#{@corrected_text_output.identifier}" do %>
                <%= link_to t("note_button"),
                            new_automatic_notes_path(
                              ai_query_id: @ai_query.id,
                              ai_output_id: @corrected_text_output.id
                            ),
                            class: "btn btn--primary",
                            data: {
                              turbo_stream: true,
                              controller: "scroll",
                              action: "click->scroll#scrollToTop"
                            } %>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="change__corrected">
          <%= @ai_query.corrected_text %>
        </div>
      <% end %>
    <% end %>

    <% @ai_query.ai_outputs.each do |output| %>
      <% next if output == @corrected_text_output %>
      <hr> <!------------>
      <%= turbo_frame_tag "#{@prompt.change_keyword}#{output.identifier}" do %>
        <div class="change">
          <div class="change__title">
            <h4><%= "#{t('ai_query.change')} #{output.identifier}" %></h4>
            <div>
              <%= button_to t("delete"),
                            ai_output_path(output.id),
                            method: :delete,
                            data: { turbo_stream: true },
                            class: "btn btn--light" %>
              <%= link_to t('followup.followup'),
                          new_followup_path(class_name: output.class, id: output.id, source_tag: @source_tag),
                          data: {
                            turbo_frame: followup_turbo_frame(@source_tag),
                            controller: "scroll",
                            action: "click->scroll#scrollToTarget",
                            scroll_target_value: followup_turbo_frame(@source_tag)
                          },
                          class: "btn btn--secondary" %>
              <% unless output.made_note %>
                <%= turbo_frame_tag "make_note_button_#{output.identifier}" do %>
                  <%= link_to t("note_button"),
                              new_automatic_notes_path(
                                ai_query_id: @ai_query.id,
                                ai_output_id: output.id,
                              ),
                              class: "btn btn--primary",
                              data: {
                                turbo_stream: true,
                                controller: "scroll",
                                action: "click->scroll#scrollToTop"
                              } %>
                <% end %>
              <% end %>
            </div>
          </div>
          <div class="change__content">
              <%= render_ai_query_change_content(@ai_query, output.identifier, 'change_', @ai_query.user, html: true) %>
          </div>
        </div>
      <% end %>
    <% end %>
    <p><%= t("model_label", model: @ai_query.model_used) %></p>
  </div>
  <div class="request-form">
    <div>
      <label for="base_content"><%= t('ai_query.original_language') %>:</label>
      <textarea id="base_content" readonly><%= @prompt.base_content if @prompt %></textarea>

    </div>
    <div>
      <label for="user_generated_content"><%= t('ai_query.learning_language') %>:</label>
      <textarea id="user_generated_content" readonly><%= @prompt.user_generated_content if @prompt %></textarea>
    </div>
    <div class="request-form__delete">
      <%= button_to t('ai_query.delete'),
                    journal_ai_query_path(@ai_query.journal, @ai_query),
                    method: :delete,
                    data: { turbo_stream: true },
                    class: "btn btn--light request-form__submit" %>

      <%= link_to t("close"),
                  journal_path(@ai_query.journal),
                  class: "btn btn--dark" %>
    </div>
  </div>
<% end %>
