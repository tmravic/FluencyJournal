<br>
<% ai_query = set_ai_query_when_job_finishes(ai_query_id, t("ai_query.processing")) %>
<% corrected_text_output = set_corrected_text_output(ai_query) %>
<% change_keyword = ai_query.prompt.change_keyword if ai_query %>
<div class="card">
  <% if corrected_text.present? %>
    <%= turbo_frame_tag "#{change_keyword}#{corrected_text_output.identifier}" do %>
      <div class="card__change__title">
        <h4><%= t("ai_query.corrected_text") %></h4>
        <div>
          <%= button_to t("delete"),
                        ai_output_path(corrected_text_output.id, source_tag: source_tag),
                        method: :delete,
                        data: { turbo_stream: true },
                        class: "btn btn--light" %>
          <%= link_to t('followup.followup'),
                      new_followup_path(
                        class_name: corrected_text_output.class,
                        id: corrected_text_output.id,
                        source_tag: source_tag,
                      ),
                      data: { turbo_frame: source_tag },
                      class: "btn btn--secondary" %>
          <% unless ai_query && corrected_text_output.made_note %>
            <%= turbo_frame_tag "make_note_button_#{corrected_text_output.identifier}" do %>
              <%= link_to t("note_button"),
                          new_automatic_notes_path(
                            ai_query_id: ai_query.id,
                            ai_output_id: corrected_text_output.id
                          ),
                          class: "btn btn--primary",
                          data: {
                            turbo_stream: true,
                            controller: "scroll",
                            action: "click->scroll#scrollToTop"
                          } %>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="card__change__corrected">
        <%= corrected_text %>
      </div>
    <% end %>
  <% elsif ai_query_id == t('ai_query.processing') %>
    <h4><%= ai_query_id %></h4>
  <% else %>
    <h4><%= t('ai_query.ai_output') %></h4>
  <% end %>

  <% if ai_query %>
    <% ai_query.ai_outputs.each do |output| %>
      <% next if output == corrected_text_output %>
      <hr>
      <%= turbo_frame_tag "#{change_keyword}#{output.identifier}" do %>
      <!-- <turbo-frame id='change_1'> -->

        <div class="card__change">
          <div class="card__change__title">
            <h4>
              <%= "#{t('ai_query.change')} #{output.identifier}" %>
              <!--Change 1-->
            </h4>
            <div>
              <%= button_to t("delete"),
                            ai_output_path(output.id, source_tag: source_tag),
                            method: :delete,
                            data: { turbo_stream: true },
                            class: "btn btn--light" %>
              <%= link_to t('followup.followup'),
                          new_followup_path(class_name: output.class, id: output.id, source_tag: source_tag),
                          data: { turbo_frame: source_tag },
                          class: "btn btn--secondary" %>
              <% unless output.made_note %>
                <%= turbo_frame_tag "make_note_button_#{output.identifier}" do %>
                  <%= link_to t("note_button"),
                              new_automatic_notes_path(
                                ai_query_id: ai_query.id,
                                ai_output_id: output.id
                              ),
                              class: "btn btn--primary",
                              data: {
                                turbo_stream: true,
                                controller: "scroll",
                                action: "click->scroll#scrollToTop"
                              } %>
                <% end %>
              <% end %>
            </div>
          </div>
          <div class="card__change_content">
            <%= render_ai_query_change_content(ai_query, output.identifier, change_keyword, user, html: true) %>
          </div>
        </div>
      <% end %>
    <% end %>
    <hr>
    <p>Model: <%= ai_query.model_used %></p>
  <% end %>
</div>
