<%= simple_form_for EntryPrompt.new, url: ai_request_journal_ai_queries_path(@journal),
             method: :post, remote: true, html: { class: "request_form" } do |f| %>
  <%= f.hidden_field :uuid, value: @uuid %>
  <%= f.hidden_field :journal_id, value: @journal.id %>
  <%= f.hidden_field :ai_model, value: "grok-4-fast-non-reasoning" %>

  <div>
    <%= f.text_area :base_content, label: t('ai_query.original_language'),
                    placeholder: t('ai_query.placeholder.original_language') %>
  </div>

  <div>
    <%= f.text_area :user_generated_content, label: t('ai_query.learning_language'),
                    placeholder: t('ai_query.placeholder.learning_language') %>
  </div>

  <%= turbo_frame_tag "ai_request_form_delete_buttons" do %>
    <div class="send_button_box">
      <%= f.hidden_field :ai_model, value: "grok-4-fast-non-reasoning" %>

      <%# model_options = ["grok-4-fast-non-reasoning", "elyza_llm"] %>
      <% model_options = ["grok-4-fast-non-reasoning"] %>
      <%# if @journal.user.learning_language == "Japanese" %>
        <%#= f.select :ai_model, options_for_select(model_options, "grok-4-fast-non-reasoning") {} %>
      <%# else %>
        <%= f.select :ai_model, options_for_select(@ai_models, "grok-4-fast-non-reasoning"), {} %>
      <%# end %>

      <%= f.submit t('ai_query.send'), class: "btn btn--primary", id: "send_button",
                   data: {
                     turbo_stream: true,
                     controller: "scroll",
                     action: "click->scroll#scrollToTarget",
                     scroll_target_value: "ai_output"
                   } %>
    </div>
  <% end %>
<% end %>
