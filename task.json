{
  "family": "fluency-journal-task",
  "requiresCompatibilities": ["EC2"],
  "networkMode": "bridge",
  "containerDefinitions": [
    {
      "name": "web",
      "image": "182181248970.dkr.ecr.ap-northeast-1.amazonaws.com/fluency_journal-web:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "RAILS_ENV",
          "value": "staging"
        },
        {
          "name": "NODE_ENV",
          "value": "staging"
        },
        {
          "name": "POSTGRES_DB",
          "value": "fluency_journal"
        },
        {
          "name": "POSTGRES_USER",
          "value": "fluency_journal"
        },
        {
          "name": "DB_HOST",
          "value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "password"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "RAILS_MASTER_KEY",
          "value": "xxxxxxxx"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:3000/up || exit 1"],
        "interval": 60,
        "timeout": 3,
        "retries": 3,
        "startPeriod": 5
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fluency-journal",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "web"
        }
      }
    },
    {
      "name": "solid_cable",
      "image": "182181248970.dkr.ecr.ap-northeast-1.amazonaws.com/fluency_journal-solid_cable:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 28080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "RAILS_ENV",
          "value": "staging"
        },
        {
          "name": "NODE_ENV",
          "value": "staging"
        },
        {
          "name": "POSTGRES_DB",
          "value": "fluency_journal"
        },
        {
          "name": "POSTGRES_USER",
          "value": "fluency_journal"
        },
        {
          "name": "DB_HOST",
          "value": "postgres"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "password"
        },
        {
          "name": "CABLE_PORT",
          "value": "28080"
        },
        {
          "name": "RAILS_MASTER_KEY",
          "value": "xxxxxxxx"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fluency-journal",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "solid_cable"
        }
      }
    },
    {
      "name": "solid_queue",
      "image": "182181248970.dkr.ecr.ap-northeast-1.amazonaws.com/fluency_journal-solid_queue:latest",
      "essential": true,
      "environment": [
        {
          "name": "RAILS_ENV",
          "value": "staging"
        },
        {
          "name": "NODE_ENV",
          "value": "staging"
        },
        {
          "name": "POSTGRES_DB",
          "value": "fluency_journal"
        },
        {
          "name": "POSTGRES_USER",
          "value": "fluency_journal"
        },
        {
          "name": "DB_HOST",
          "value": "postgres"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "password"
        },
        {
          "name": "RAILS_MASTER_KEY",
          "value": "xxxxxxxx"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fluency-journal",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "solid_queue"
        }
      }
    },
    {
      "name": "apache",
      "image": "httpd:2.4",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost/session/new || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 10
      },
      "dependsOn": [
        {
          "containerName": "web",
          "condition": "HEALTHY"
        },
        {
          "containerName": "solid_cable",
          "condition": "START"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fluency-journal",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "apache"
        }
      }
    }
  ],
  "executionRoleArn": "arn:aws:iam::182181248970:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::182181248970:role/ecsTaskRole"
}
