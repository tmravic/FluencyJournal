{
  "family": "fluency-journal-task",
  "requiresCompatibilities": ["EC2"],
  "networkMode": "bridge",
  "containerDefinitions": [
    {
      "name": "web",
      "image": "<WEB_IMAGE>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "RAILS_ENV",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/rails_env"
        },
        {
          "name": "NODE_ENV",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/node_env"
        },
        {
          "name": "POSTGRES_DB",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/postgres_db"
        },
        {
          "name": "POSTGRES_USER",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/postgres_user"
        },
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/db_host"
        },
        {
          "name": "PORT",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/port"
        },
        {
          "name": "RUBY_VERSION",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/ruby_version"
        }
      ],
      "secrets": [
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/postgres_password"
        },
        {
          "name": "RAILS_MASTER_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/rails_master_key"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:3000/up || exit 1"],
        "interval": 60,
        "timeout": 3,
        "retries": 3,
        "startPeriod": 5
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fluency-journal",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "web"
        }
      }
    },
    {
      "name": "solid_cable",
      "image": "<SOLID_CABLE_IMAGE>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 28080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "RAILS_ENV",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/rails_env"
        },
        {
          "name": "CABLE_PORT",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/cable_port"
        },
        {
          "name": "POSTGRES_DB",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/postgres_db"
        },
        {
          "name": "POSTGRES_USER",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/postgres_user"
        },
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/db_host"
        }
      ],
      "secrets": [
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/postgres_password"
        },
        {
          "name": "RAILS_MASTER_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/rails_master_key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fluency-journal",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "solid_cable"
        }
      }
    },
    {
      "name": "solid_queue",
      "image": "<SOLID_QUEUE_IMAGE>",
      "essential": true,
      "environment": [
        {
          "name": "RAILS_ENV",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/rails_env"
        },
        {
          "name": "POSTGRES_DB",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/postgres_db"
        },
        {
          "name": "POSTGRES_USER",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/postgres_user"
        },
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/db_host"
        }
      ],
      "secrets": [
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/postgres_password"
        },
        {
          "name": "RAILS_MASTER_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:182181248970:parameter/fluency_journal/rails_master_key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fluency-journal",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "solid_queue"
        }
      }
    },
    {
      "name": "apache",
      "image": "<APACHE_IMAGE>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost/session/new || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 10
      },
      "dependsOn": [
        {
          "containerName": "web",
          "condition": "HEALTHY"
        },
        {
          "containerName": "solid_cable",
          "condition": "START"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fluency-journal",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "apache"
        }
      }
    }
  ],
  "executionRoleArn": "arn:aws:iam::182181248970:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::182181248970:role/ecsTaskRole"
}